<Page x:Class="Missum.App.Pages.NativeAssistantPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
 FontFamily="Segoe UI Variable Text" FontWeight="Normal" Background="{ThemeResource MissumWindowBrush}" Loaded="OnLoaded">
 <Page.Resources>
  <StaticResource x:Key="RoundIconHoverBackground" ResourceKey="MissumHoverBrush"/>
  <StaticResource x:Key="RoundIconHoverBorder" ResourceKey="MissumStrokeBrush"/>
  <StaticResource x:Key="RoundIconPressedBackground" ResourceKey="MissumPressedBrush"/>
  <StaticResource x:Key="RoundIconPressedBorder" ResourceKey="MissumAccentBrush"/>
  <ControlTemplate x:Key="ScrollPageButton" TargetType="primitives:RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
  <Style x:Key="OuterScrollStyle" TargetType="primitives:ScrollBar">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:ScrollBar">
    <Grid x:Name="Root"><Grid x:Name="VerticalRoot" Background="Transparent">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <primitives:RepeatButton x:Name="VerticalSmallDecrease" Height="0" IsTabStop="False" Template="{StaticResource ScrollPageButton}"/>
     <primitives:RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0" IsTabStop="False" Template="{StaticResource ScrollPageButton}"/>
     <primitives:Thumb x:Name="VerticalThumb" Grid.Row="2" Width="12" MinHeight="28" Background="{ThemeResource MissumMutedTextBrush}">
      <primitives:Thumb.Template><ControlTemplate TargetType="primitives:Thumb"><Grid Background="Transparent"><Border Width="5" HorizontalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="3"/></Grid></ControlTemplate></primitives:Thumb.Template>
     </primitives:Thumb>
     <primitives:RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" IsTabStop="False" Template="{StaticResource ScrollPageButton}"/>
     <primitives:RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Height="0" IsTabStop="False" Template="{StaticResource ScrollPageButton}"/>
    </Grid></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="SurfaceRoot" Background="Transparent">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MissumHoverBrush}"/><Setter Target="Surface.CornerRadius" Value="4"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource MissumPressedBrush}"/><Setter Target="Surface.CornerRadius" Value="4"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SurfaceRoot.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}"/></Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></Style>
  <Style x:Key="RoundIconButtonStyle" TargetType="Button">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
   <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="16"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="RootGrid" Background="Transparent">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Circle.CornerRadius" Value="4"/><Setter Target="Circle.Background" Value="{ThemeResource RoundIconHoverBackground}"/><Setter Target="Circle.BorderBrush" Value="{ThemeResource RoundIconHoverBorder}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Circle.CornerRadius" Value="4"/><Setter Target="Circle.Background" Value="{ThemeResource RoundIconPressedBackground}"/><Setter Target="Circle.BorderBrush" Value="{ThemeResource RoundIconPressedBorder}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RootGrid.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Border x:Name="Circle" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
     </Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ComposerRoundIconButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundIconButtonStyle}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
   <Setter Property="MinWidth" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="18"/>
  </Style>
  <Style x:Key="ComposerChipStyle" TargetType="Button">
   <Setter Property="Background" Value="{ThemeResource MissumLayerStrongBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource MissumStrokeBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="17"/>
   <Setter Property="Padding" Value="13,6"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="ActiveComposerChipStyle" TargetType="Button" BasedOn="{StaticResource ComposerChipStyle}">
   <Setter Property="Background" Value="{ThemeResource MissumAccentSubtleBrush}"/>
   <Setter Property="BorderBrush" Value="{ThemeResource MissumAccentBrush}"/>
  </Style>
 </Page.Resources>
 <Grid x:Name="LayoutRoot" Margin="0" ColumnSpacing="0">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="288"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{ThemeResource MissumLayerBrush}" BorderBrush="{ThemeResource MissumStrokeBrush}" BorderThickness="0,1,1,0" CornerRadius="0" Padding="11,11,11,7">
   <Grid RowSpacing="4">
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
     <Button x:Name="ModeButton" Click="OnModeMenu" HorizontalAlignment="Left" Padding="6,3" CornerRadius="10">
      <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock x:Name="ModeLabel" Text="ChatGPT" FontSize="18" FontWeight="SemiBold"/><FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource MissumMutedTextBrush}"/></StackPanel>
     </Button>
     <Button Grid.Column="1" Style="{StaticResource RoundIconButtonStyle}" Click="OnSearchClick" ToolTipService.ToolTip="Chats durchsuchen" AutomationProperties.Name="Chats durchsuchen"><FontIcon Glyph="&#xE721;" FontSize="15"/></Button>
    </Grid>
    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,20,0" PlaceholderText="Chats durchsuchen" Visibility="Collapsed" TextChanged="OnSearchChanged"/>
    <!-- Reserve a permanent gutter for the native scrollbar, including its expanded hover state. -->
    <ScrollViewer Grid.Row="2" MinWidth="0" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="7" Margin="0,0,20,0" MinWidth="0">
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="Projekte" FontSize="13" Foreground="{ThemeResource MissumMutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource RoundIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnAddProject" ToolTipService.ToolTip="Projekt hinzufügen" AutomationProperties.Name="Projekt hinzufügen"><FontIcon Glyph="&#xE710;" FontSize="13"/></Button></Grid>
     <StackPanel x:Name="ProjectsPanel" Spacing="4"/>
    </StackPanel></ScrollViewer>
   </Grid>
  </Border>
  <Border x:Name="AssistantFrame" Grid.Column="1" BorderBrush="{ThemeResource MissumStrokeBrush}" BorderThickness="0,1,0,0" CornerRadius="0" Background="{ThemeResource MissumWindowBrush}" PointerWheelChanged="OnAssistantPointerWheelChanged">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="{ThemeResource MissumStrokeBrush}" BorderThickness="0,0,0,1">
    <Grid Padding="16,7" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource RoundIconButtonStyle}" Click="OnToggleSidebar" ToolTipService.ToolTip="Seitenleiste umschalten" AutomationProperties.Name="Seitenleiste umschalten"><FontIcon Glyph="&#xE700;" FontSize="15"/></Button>
     <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><StackPanel x:Name="SessionTabsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/></ScrollViewer>
     <Button Grid.Column="2" x:Name="InspectorToggle" Style="{StaticResource RoundIconButtonStyle}" Click="OnToggleInspector" ToolTipService.ToolTip="Ausgaben schließen" AutomationProperties.Name="Ausgaben schließen"><FontIcon Glyph="&#xE8A7;" FontSize="16"/></Button>
    </Grid>
   </Border>
   <Grid Grid.Row="1" x:Name="BodyGrid" SizeChanged="OnBodySizeChanged">
    <Grid Padding="20,0,20,16">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="ConversationScroll" SizeChanged="OnConversationSizeChanged" ViewChanged="OnConversationViewChanged" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="42,20,42,24">
      <Grid x:Name="ConversationContent" HorizontalAlignment="Stretch">
       <StackPanel x:Name="MessagesPanel" Spacing="24"/>
       <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="0,130,0,90"><TextBlock Text="Womit kann ich dir helfen?" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Schreiben, entdecken, entwickeln." Foreground="{ThemeResource MissumMutedTextBrush}" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
     </ScrollViewer>
     <Canvas x:Name="PromptTimeline" Width="32" Margin="0,20,0,24" HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed" SizeChanged="OnPromptTimelineSizeChanged" Canvas.ZIndex="4" AutomationProperties.Name="Chronologische Prompt-Navigation"/>
     <Button x:Name="ScrollToBottomButton" Style="{StaticResource RoundIconButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Background="{ThemeResource MissumLayerStrongBrush}" BorderBrush="{ThemeResource MissumStrokeBrush}" Click="OnScrollToBottom" ToolTipService.ToolTip="Zum neuesten Beitrag" AutomationProperties.Name="Zum neuesten Beitrag">
      <Path Width="16" Height="16" Data="M8,2 L8,14 M3,9 L8,14 L13,9" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Button>
     <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error" Margin="0,0,0,8"/>
     <StackPanel Grid.Row="2" MaxWidth="960" HorizontalAlignment="Stretch" Spacing="7">
      <Grid x:Name="ComposerStatusRow" Visibility="Collapsed" Height="26" Margin="14,0" ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ProgressRing x:Name="ActivityRing" Width="16" Height="16" IsActive="False" Foreground="{ThemeResource MissumAccentBrush}"/>
       <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{ThemeResource MissumMutedTextBrush}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
      <ScrollViewer x:Name="ComposerChipsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" HorizontalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="CaptionChip" Content="Live-Untertitel  ×" Style="{StaticResource ActiveComposerChipStyle}" Visibility="Collapsed" Click="OnStopCaptions" ToolTipService.ToolTip="Live-Untertitel beenden" AutomationProperties.Name="Live-Untertitel beenden"/>
        <Button x:Name="SelectedToolChip" Style="{StaticResource ActiveComposerChipStyle}" Visibility="Collapsed" Click="OnClearTool" MaxWidth="280"/>
        <Button x:Name="ChangesSummaryButton" Style="{StaticResource ComposerChipStyle}" Visibility="Collapsed" Click="OnChangesSummaryClick" AutomationProperties.Name="Dateiänderungen überprüfen"/>
       </StackPanel>
      </ScrollViewer>
      <Border x:Name="ComposerSurface" Background="{ThemeResource MissumInputBrush}" BorderBrush="{ThemeResource MissumStrokeBrush}" BorderThickness="1" CornerRadius="26" Padding="12,10,10,9">
       <ContentControl x:Name="ComposerInteractionHost" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
       <Grid RowSpacing="9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <TextBox x:Name="Composer" PlaceholderText="Frag etwas" FontSize="16" MinHeight="48" MaxHeight="240" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="12,6" TextChanged="OnDraftChanged" GotFocus="OnComposerGotFocus" LostFocus="OnComposerLostFocus" AutomationProperties.Name="Nachricht">
         <TextBox.Resources>
          <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
         </TextBox.Resources>
        </TextBox>
        <Grid Grid.Row="1" Margin="3,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="48"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
         <Button Style="{StaticResource ComposerRoundIconButtonStyle}" Click="OnToolsClick" ToolTipService.ToolTip="Dateien und Werkzeuge" AutomationProperties.Name="Dateien und Werkzeuge"><FontIcon Glyph="&#xE710;" FontSize="19"/></Button>
         <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="0,0,14,0">
          <Button x:Name="ContextIndicator" Style="{StaticResource ComposerRoundIconButtonStyle}" PointerEntered="OnContextPointerEntered" PointerExited="OnContextPointerExited" Click="OnContextClicked" AutomationProperties.Name="Kontext noch nicht gemessen">
           <ToolTipService.ToolTip><ToolTip x:Name="ContextToolTip" Placement="Top" Content="Kontext noch nicht gemessen"/></ToolTipService.ToolTip>
           <ProgressRing x:Name="ContextRing" Width="18" Height="18" IsActive="True" IsIndeterminate="False" Value="0" Maximum="100" Foreground="{ThemeResource MissumAccentBrush}" Background="{ThemeResource MissumStrokeBrush}" IsHitTestVisible="False"/>
          </Button>
          <Button x:Name="ModelButton" Click="OnReasoningClick" CornerRadius="18" Padding="11,5" Background="{ThemeResource MissumLayerStrongBrush}" ToolTipService.ToolTip="Modell und Reasoning auswählen">
           <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="ModelLabel" Text="Modell auswählen" FontSize="14" MaxWidth="170" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ReasoningLabel" Text="" FontSize="14" Foreground="{ThemeResource MissumAccentBrush}"/><FontIcon Glyph="&#xE76C;" FontSize="9"/></StackPanel>
          </Button>
         </StackPanel>
         <Button x:Name="DictationButton" Grid.Column="3" Style="{StaticResource ComposerRoundIconButtonStyle}" HorizontalAlignment="Left" Click="OnMicrophone" ToolTipService.ToolTip="Diktieren" AutomationProperties.Name="Diktieren"><Grid><FontIcon x:Name="DictationIcon" Glyph="&#xE720;" FontSize="18"/><StackPanel x:Name="DictationBars" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
         <Button Grid.Column="4" x:Name="SendButton" Style="{StaticResource ComposerRoundIconButtonStyle}" Click="OnSendClick" Background="{ThemeResource MissumAccentBrush}" Foreground="{ThemeResource MissumAccentTextBrush}" AutomationProperties.Name="Nachricht senden">
          <Button.Resources><StaticResource x:Key="RoundIconHoverBackground" ResourceKey="AccentFillColorSecondaryBrush"/><StaticResource x:Key="RoundIconHoverBorder" ResourceKey="MissumAccentBrush"/><StaticResource x:Key="RoundIconPressedBackground" ResourceKey="AccentFillColorTertiaryBrush"/><StaticResource x:Key="RoundIconPressedBorder" ResourceKey="MissumAccentBrush"/></Button.Resources>
           <FontIcon x:Name="SendIcon" Glyph="&#xE74A;" FontSize="17" Foreground="{ThemeResource MissumAccentTextBrush}"/>
         </Button>
        </Grid>
       </Grid>
       </ContentControl>
      </Border>
     </StackPanel>
    </Grid>
    <Border x:Name="Inspector" Visibility="Visible" HorizontalAlignment="Right" VerticalAlignment="Top" Width="304" Background="{ThemeResource MissumLayerStrongBrush}" BorderBrush="{ThemeResource MissumStrokeBrush}" BorderThickness="1" CornerRadius="24" Padding="18,12,18,18" Margin="0,10,22,0" Translation="0,0,32" AutomationProperties.Name="Ausgaben und Quellen">
     <Border.Shadow><ThemeShadow/></Border.Shadow>
     <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
      <StackPanel Spacing="18"><Grid><TextBlock Text="Ausgaben" FontSize="14" Foreground="{ThemeResource MissumMutedTextBrush}" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource RoundIconButtonStyle}" Click="OnToggleInspector" ToolTipService.ToolTip="Ausgaben schließen" AutomationProperties.Name="Ausgaben schließen"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid><Grid x:Name="InspectorProjectRow" PointerEntered="OnInspectorProjectEntered" PointerExited="OnInspectorProjectExited" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="16"/><TextBlock Grid.Column="1" x:Name="WorkspaceText" Text="Kein Projekt ausgewählt" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" x:Name="InspectorProjectMenu" Opacity="0" Style="{StaticResource RoundIconButtonStyle}" Click="OnInspectorProjectMenu" GotFocus="OnInspectorProjectEntered" LostFocus="OnInspectorProjectExited" AutomationProperties.Name="Projektoptionen"><FontIcon Glyph="&#xE712;" FontSize="17"/></Button></Grid><StackPanel x:Name="OutputsPanel" Spacing="8"/><TextBlock Text="Quellen" FontSize="14" Foreground="{ThemeResource MissumMutedTextBrush}"/><StackPanel x:Name="SourcesPanel" Spacing="8"/><TextBlock x:Name="SourcesEmpty" Text="Noch keine Quellen" Foreground="{ThemeResource MissumMutedTextBrush}" Opacity="0.75" FontSize="12"/></StackPanel>
     </ScrollViewer>
    </Border>
    <primitives:ScrollBar x:Name="OuterChatScrollBar" Style="{StaticResource OuterScrollStyle}" Width="12" Margin="0,0,5,5" HorizontalAlignment="Right" Orientation="Vertical" Visibility="Collapsed" SmallChange="48" ValueChanged="OnOuterScrollChanged" AutomationProperties.Name="Chat scrollen"/>
   </Grid>
   <ScrollViewer x:Name="ReviewScroll" Grid.Row="1" Visibility="Collapsed" Padding="28,22,28,28" SizeChanged="OnReviewSizeChanged" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Left" AutomationProperties.Name="Git-Diffs des AI-Laufs">
    <StackPanel x:Name="ReviewChangesPanel" HorizontalAlignment="Left" Spacing="16"/>
   </ScrollViewer>
   <ContentControl x:Name="ResearchHost" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Forschungsstand dieser Sitzung"/>
  </Grid>
  </Border>
 </Grid>
</Page>



