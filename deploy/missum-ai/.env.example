MISSUM_AI_DATA_ROOT=C:/ProgramData/Missum-AI-Stack
MISSUM_AI_MODEL_ROOT=C:/ProgramData/Missum-AI-Stack/Models
MISSUM_AI_NATIVE_MODEL_ROOT=C:/Users/AMD/.cache/huggingface/hub
MISSUM_AI_IMAGE_VERSION=2.0.0
MISSUM_AI_CODING_MODEL_ROOT=C:/Users/AMD/.cache/huggingface/hub
# 0 means unlimited Coding work; finite per-tool and transport stall limits remain.
MISSUM_AI_CODING_MAXIMUM_MODEL_ROUNDS=0
MISSUM_AI_CODING_MAXIMUM_TOOL_CALLS=0
# Maximum uninterrupted reasoning-only phase per model request: 1..1440 minutes.
MISSUM_AI_REASONING_ONLY_TIMEOUT_MINUTES=30
MISSUM_AI_MODEL_RUNTIME_URL=http://host.docker.internal:8081
# Native llama.cpp runs on Windows; gateway reaches the host on port 8081.
